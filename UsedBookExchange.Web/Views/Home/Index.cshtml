@{
    ViewData["Title"] = "Home";
}

<!-- =========================
     HERO SECTION
========================== -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- Hero Text -->

            <div class="col-lg-7">

                <span class="badge rounded-pill bg-light text-dark px-3 py-2 mb-4">
                    📚 Give Books a Second Life
                </span>

                <h1 class="hero-title mb-4">
                    Exchange Books.
                    <br />
                    Discover Stories.
                </h1>

                <p class="hero-text mb-4">
                    UsedBookExchange makes it easy to share books
                    you no longer need and discover new stories
                    from other readers.
                </p>


                <div class="d-flex flex-wrap gap-3">

                    <a asp-controller="Books"
                       asp-action="Index"
                       class="btn btn-light btn-lg px-4">

                        Browse Books

                    </a>


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Books"
                           asp-action="Create"
                           class="btn btn-outline-light btn-lg px-4">

                            Add Your Book

                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Register"
                           class="btn btn-outline-light btn-lg px-4">

                            Join the Community

                        </a>
                    }

                </div>

            </div>


            <!-- Hero Visual -->

            <div class="col-lg-5">

                <div class="hero-card">

                    <div class="mb-4">

                        <span class="text-white-50">
                            How it works
                        </span>

                        <h3 class="text-white mt-2 mb-0">
                            Simple. Safe. Community-driven.
                        </h3>

                    </div>


                    <div class="d-flex align-items-start mb-4">

                        <div class="feature-icon me-3">
                            📖
                        </div>

                        <div>

                            <h6 class="text-white mb-1">
                                List a Book
                            </h6>

                            <p class="text-white-50 mb-0">
                                Add books you no longer need.
                            </p>

                        </div>

                    </div>


                    <div class="d-flex align-items-start mb-4">

                        <div class="feature-icon me-3">
                            🔎
                        </div>

                        <div>

                            <h6 class="text-white mb-1">
                                Find a Book
                            </h6>

                            <p class="text-white-50 mb-0">
                                Search and discover books
                                from other readers.
                            </p>

                        </div>

                    </div>


                    <div class="d-flex align-items-start">

                        <div class="feature-icon me-3">
                            🤝
                        </div>

                        <div>

                            <h6 class="text-white mb-1">
                                Exchange
                            </h6>

                            <p class="text-white-50 mb-0">
                                Send a request and complete
                                the exchange.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- =========================
     FEATURES
========================== -->

<section class="page-section">

    ```
    <div class="container">

        <div class="text-center mb-5">

            <span class="text-primary fw-semibold">
                WHY USE USEDBOOKEXCHANGE?
            </span>

            <h2 class="page-title mt-2">
                Everything you need to exchange books
            </h2>

            <p class="page-subtitle mx-auto">
                A simple platform designed to make discovering,
                requesting and exchanging used books easier.
            </p>

        </div>


        <div class="row g-4">

            <!-- Feature 1 -->

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon">
                        🔎
                    </div>

                    <h5>
                        Easy Search
                    </h5>

                    <p class="text-muted mb-0">
                        Quickly find books by title,
                        author, category or condition.
                    </p>

                </div>

            </div>


            <!-- Feature 2 -->

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon">
                        🔐
                    </div>

                    <h5>
                        Secure Accounts
                    </h5>

                    <p class="text-muted mb-0">
                        User authentication and authorization
                        keep your account and books protected.
                    </p>

                </div>

            </div>


            <!-- Feature 3 -->

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon">
                        🤝
                    </div>

                    <h5>
                        Simple Exchange
                    </h5>

                    <p class="text-muted mb-0">
                        Send requests, accept exchanges and
                        track the status of your books.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- =========================
     HOW IT WORKS
========================== -->

<section class="page-section bg-white">
    <div class="container">

        <div class="text-center mb-5">

            <span class="text-primary fw-semibold">
                HOW IT WORKS
            </span>

            <h2 class="page-title mt-2">
                Exchange a book in three steps
            </h2>

        </div>


        <div class="row g-4">

            <!-- Step 1 -->

            <div class="col-md-4">

                <div class="text-center px-3">

                    <div class="feature-icon mx-auto">
                        1
                    </div>

                    <h5 class="mt-3">
                        Add Your Book
                    </h5>

                    <p class="text-muted">
                        List a used book with its title,
                        author, category and condition.
                    </p>

                </div>

            </div>


            <!-- Step 2 -->

            <div class="col-md-4">

                <div class="text-center px-3">

                    <div class="feature-icon mx-auto">
                        2
                    </div>

                    <h5 class="mt-3">
                        Receive a Request
                    </h5>

                    <p class="text-muted">
                        Other users can discover your book
                        and send an exchange request.
                    </p>

                </div>

            </div>


            <!-- Step 3 -->

            <div class="col-md-4">

                <div class="text-center px-3">

                    <div class="feature-icon mx-auto">
                        3
                    </div>

                    <h5 class="mt-3">
                        Complete the Exchange
                    </h5>

                    <p class="text-muted">
                        Accept a request and complete the
                        exchange when the book is handed over.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- =========================
     FINAL CTA
========================== -->

<section class="page-section">

    ```
    <div class="container">

        <div class="card border-0"
             style="
             background: linear-gradient(
                 135deg,
                 #5b5bd6,
                 #7c5cff
             );
             color: white;
             border-radius: 20px;
         ">

            <div class="card-body p-5 text-center">

                <h2 class="fw-bold mb-3">
                    Ready to discover your next book?
                </h2>

                <p class="mb-4"
                   style="color: rgba(255,255,255,0.8);">

                    Explore books shared by other readers
                    or give one of your books a new home.

                </p>


                <a asp-controller="Books"
                   asp-action="Index"
                   class="btn btn-light btn-lg px-4">

                    Browse Available Books

                </a>

            </div>

        </div>

    </div>

</section>
