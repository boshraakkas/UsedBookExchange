@model UsedBookExchange.Web.ViewModels.BookRequestViewModel

@{
    ViewData["Title"] = "Request Book";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h1 class="mb-4">
                        Request This Book
                    </h1>

                    <p class="text-muted">
                        Send a request to the book owner.
                    </p>

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="BookId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Message"
                                   class="form-label">
                                Message
                            </label>

                            <textarea asp-for="Message"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Write a message to the book owner...">
                            </textarea>

                            <span asp-validation-for="Message"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mt-4">

                            <button type="submit"
                                    class="btn btn-success">
                                Send Request
                            </button>

                            <a asp-controller="Books"
                               asp-action="Details"
                               asp-route-id="@Model.BookId"
                               class="btn btn-secondary ms-2">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}