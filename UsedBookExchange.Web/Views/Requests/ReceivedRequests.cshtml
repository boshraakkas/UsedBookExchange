@model IEnumerable<UsedBookExchange.Domain.Entities.BookRequest>

@{
    ViewData["Title"] = "Received Requests";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>Received Requests</h1>

        <a asp-controller="Books"
           asp-action="Index"
           class="btn btn-primary">
            Browse Books
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have not received any book requests yet.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var request in Model)
            {
                <div class="col-md-6 mb-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h5 class="card-title">
                                @request.Book.Title
                            </h5>

                            <p class="card-text">
                                <strong>Author:</strong>
                                @request.Book.Author
                            </p>

                            <p class="card-text">
                                <strong>Requester:</strong>
                                @request.RequesterId
                            </p>

                            <p class="card-text">
                                <strong>Status:</strong>

                                @if (request.Status ==
                               UsedBookExchange.Domain.Enums.RequestStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (request.Status ==
                                UsedBookExchange.Domain.Enums.RequestStatus.Accepted)
                                {
                                    <span class="badge bg-success">
                                        Accepted
                                    </span>
                                }
                                else if (request.Status ==
                                UsedBookExchange.Domain.Enums.RequestStatus.Rejected)
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else if (request.Status ==
                                UsedBookExchange.Domain.Enums.RequestStatus.Completed)
                                {
                                    <span class="badge bg-primary">
                                        Completed
                                    </span>
                                }

                            </p>

                            @if (!string.IsNullOrWhiteSpace(request.Message))
                            {
                                <p class="card-text">

                                    <strong>Message:</strong>

                                    <br />

                                    @request.Message

                                </p>
                            }

                            <p class="text-muted mb-0">

                                Requested on:

                                @request.CreatedAt
                                .ToLocalTime()
                                .ToString("yyyy-MM-dd HH:mm")

                            </p>

                        </div>

                        @if (request.Status ==
                       UsedBookExchange.Domain.Enums.RequestStatus.Pending)
                        {
                            <div class="card-footer bg-white">

                                <form asp-action="Accept"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@request.Id" />

                                    <button type="submit"
                                            class="btn btn-success">
                                        Accept
                                    </button>

                                </form>

                                <form asp-action="Reject"
                                      method="post"
                                      class="d-inline ms-2">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@request.Id" />

                                    <button type="submit"
                                            class="btn btn-danger">
                                        Reject
                                    </button>

                                </form>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>