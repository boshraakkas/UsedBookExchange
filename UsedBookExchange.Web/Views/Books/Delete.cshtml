@model UsedBookExchange.Domain.Entities.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h1 class="text-danger mb-4">
                        Delete Book
                    </h1>

                    <div class="alert alert-warning">
                        Are you sure you want to delete this book?
                    </div>

                    <dl class="row">

                        <dt class="col-sm-4">
                            Title
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Title
                        </dd>

                        <dt class="col-sm-4">
                            Author
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Author
                        </dd>

                        <dt class="col-sm-4">
                            Category
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Category
                        </dd>

                        <dt class="col-sm-4">
                            Condition
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Condition
                        </dd>

                        <dt class="col-sm-4">
                            Status
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Status
                        </dd>

                    </dl>

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />

                        <button type="submit"
                                class="btn btn-danger">
                            Delete
                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-secondary ms-2">
                            Cancel
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>